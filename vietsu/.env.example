# ===== VIỆT SỬ V3.8 — sao chép file này thành .env (cùng thư mục main.py) rồi điền giá trị =====
# Tạo mã ngẫu nhiên:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# Mã quản trị: lưu nháp, sửa nội dung (tối thiểu 24 ký tự)
VIETSU_ADMIN_TOKEN=
# Mã thẩm định: được XUẤT BẢN bài lên website (tối thiểu 24 ký tự, khác mã quản trị)
VIETSU_REVIEW_TOKEN=
# Đặt 1 nếu muốn mã quản trị cũng được xuất bản (một người tự biên tập + duyệt)
VIETSU_ADMIN_CAN_PUBLISH=0

# Tên miền thật, có https, KHÔNG có dấu / ở cuối (localhost = tự chặn Google lập chỉ mục)
SITE_URL=https://ten-mien-cua-anh.vn
# Danh sách tên miền hợp lệ, cách nhau dấu phẩy (để trống = không kiểm tra)
ALLOWED_HOSTS=ten-mien-cua-anh.vn,www.ten-mien-cua-anh.vn

# AI viết bản nháp (không bắt buộc)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Nâng cao
VIETSU_ENABLE_DOCS=0
VIETSU_RATE_PER_MIN=240
VIETSU_MAX_BODY_MB=8
